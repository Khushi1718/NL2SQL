# MongoDB Atlas or Local MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE_NAME=querymate

# Google Gemini API Key (leave empty to use intelligent Demo Mode with built-in heuristic/few-shot responses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Security
SECRET_KEY=querymate-super-secret-key-2026
MAX_UPLOAD_SIZE_MB=25

# Safety & Execution limits
QUERY_TIMEOUT_SECONDS=5
MAX_ROWS_LIMIT=500
DEMO_MODE=true
